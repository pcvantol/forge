{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-workset-activity/v1",
  "title": "Scoped retained workset activity and read checkpoints",
  "oneOf": [
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/detail"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "legacy_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "committed_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "mission_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mission_state_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "approved": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "eligibility": {
          "enum": [
            "ELIGIBLE",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "execution_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "engineering_result": {
          "enum": [
            "PROVEN",
            "UNPROVEN",
            "UNKNOWN"
          ]
        },
        "review_state": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NONE",
            "UNKNOWN"
          ]
        },
        "final_acceptance": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "effect_mode": {
          "enum": [
            "READ_ONLY_ASSESSMENT",
            "DOCUMENTATION_ONLY",
            "ARCHITECTURE_DESIGN_ONLY",
            "BOUNDED_REPOSITORY_CHANGE",
            "UNKNOWN"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "detail_reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "mission_id"
              ],
              "properties": {
                "kind": {
                  "const": "MISSION_REVIEW"
                },
                "mission_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              }
            }
          ]
        },
        "allocation_binding": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "candidate_id",
                "subject_revision",
                "mission_id",
                "installation_id",
                "envelope_digest"
              ],
              "properties": {
                "kind": {
                  "const": "CANONICAL_CANDIDATE_INTAKE"
                },
                "candidate_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "subject_revision": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "mission_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "installation_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "envelope_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "evidence_references": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "subject_id",
              "digest"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "MISSION_COMPLETION",
                  "FINAL_BUSINESS_ACCEPTANCE"
                ]
              },
              "subject_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "digest": {
