          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dossier_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
