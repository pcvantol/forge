        "decision_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "human_binding": {
