          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected_decision_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "previous_decision_id": {
