    "EffectDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_revision",
        "principal_id",
        "audience",
        "grant_id",
        "human_binding",
        "occurred_at",
        "contract_version",
        "instance_id",
        "dossier_id",
        "operation_id",
        "plan_id",
        "plan_digest",
        "purpose",
        "decision",
        "reason",
        "expected_decision_revision",
        "previous_decision_id",
        "request_digest",
