            "operator_binding_version": {
              "type": "integer",
              "minimum": 1
            },
            "installation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "contract_version": {
          "const": "forge-genesis-bootstrap-effect-plan/v1"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dossier_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
