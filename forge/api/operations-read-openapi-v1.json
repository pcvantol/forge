{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Forge Operations Read API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/missions/{mission_id}": {
      "get": {
        "description": "Read one authoritative installed Mission projection without changing it.",
        "parameters": [
          {
            "in": "path",
            "name": "mission_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {"description": "Mission projection is available"},
          "400": {"description": "Mission reference is invalid"},
          "401": {"description": "Bearer authentication is missing or invalid"},
          "404": {"description": "Mission is missing"},
          "409": {"description": "Mission identity is ambiguous or inconsistent"},
          "503": {"description": "Mission projection is unavailable"}
        },
        "security": [{"bearerAuth": []}]
      }
    },
    "/v1/status": {
      "get": {
        "description": "Read the authoritative installed Forge runtime status projection.",
        "responses": {
          "200": {"description": "Status projection is available"},
          "401": {"description": "Bearer authentication is missing or invalid"},
          "503": {"description": "Installed runtime projection is unavailable"}
        },
        "security": [{"bearerAuth": []}]
      }
    }
  },
  "servers": [{"url": "http://127.0.0.1:8765"}]
}
