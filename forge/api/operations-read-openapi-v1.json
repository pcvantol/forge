{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1"
          },
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "read_only": {
            "const": true
          }
        },
        "required": [
          "api_version",
          "error",
          "read_only"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1"
          },
          "capabilities": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "blocking_check_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "capability_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "degraded": {
                  "type": "boolean"
                },
                "degraded_check_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "ready": {
                  "type": "boolean"
                },
                "required_check_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "state": {
                  "enum": [
                    "READY",
                    "UNAVAILABLE",
                    "UNKNOWN"
                  ]
                }
              },
              "required": [
                "capability_id",
                "state",
                "ready",
                "degraded",
                "required_check_ids",
                "blocking_check_ids",
                "degraded_check_ids"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "capability_scope": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "age_seconds": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "applicability": {
                  "enum": [
                    "REQUIRED",
                    "OPTIONAL"
                  ]
                },
                "capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "check_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "component_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "expires_at": {
                  "format": "date-time",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "freshness": {
                  "enum": [
                    "FRESH",
                    "MISSING",
                    "STALE",
                    "EXPIRED",
                    "TIMED_OUT",
                    "FUTURE",
                    "NOT_APPLICABLE"
                  ]
                },
                "observation_state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNKNOWN",
                    "TIMED_OUT",
                    null
                  ]
                },
                "observed_at": {
                  "format": "date-time",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "purpose": {
                  "enum": [
                    "LIVENESS",
                    "READINESS"
                  ]
                },
                "reason_code": {
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNKNOWN",
                    "DISABLED"
                  ]
                },
                "timeout_seconds": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "component_id",
                "check_id",
                "purpose",
                "applicability",
                "enabled",
                "capabilities",
                "state",
                "freshness",
                "observation_state",
                "observed_at",
                "expires_at",
                "age_seconds",
                "timeout_seconds",
                "reason_code"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "evaluated_at": {
            "format": "date-time",
            "type": "string"
          },
          "installation_id": {
            "minLength": 1,
            "type": "string"
          },
          "liveness": {
            "additionalProperties": false,
            "properties": {
              "alive": {
                "type": "boolean"
              },
              "check_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "state": {
                "enum": [
                  "ALIVE",
                  "NOT_ALIVE",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "state",
              "alive",
              "check_ids"
            ],
            "type": "object"
          },
          "observation_provenance": {
            "additionalProperties": false,
            "properties": {
              "bounded": {
                "const": true
              },
              "collector": {
                "const": "installed-runtime-read-only"
              },
              "integrity_observation_count": {
                "const": 1
              },
              "registry_byte_limit": {
                "minimum": 1,
                "type": "integer"
              },
              "runtime_marker_byte_limit": {
                "minimum": 1,
                "type": "integer"
              },
              "snapshot_byte_limit": {
                "minimum": 1,
                "type": "integer"
              },
              "source_snapshot": {
                "enum": [
                  "direct_immutable",
                  "bounded_sidecar_copy"
                ]
              },
              "sources": {
                "additionalProperties": false,
                "properties": {
                  "dispatcher_state": {
                    "const": "dispatcher_state"
                  },
                  "installed_api": {
                    "const": "installed_process"
                  },
                  "operational_reset_maintenance": {
                    "const": "operational_reset_state"
                  },
                  "runtime_state": {
                    "const": "runtime_metadata"
                  },
                  "sqlite_integrity": {
                    "const": "sqlite_integrity_check"
                  }
                },
                "required": [
                  "dispatcher_state",
                  "installed_api",
                  "operational_reset_maintenance",
                  "runtime_state",
                  "sqlite_integrity"
                ],
                "type": "object"
              },
              "timeout_seconds": {
                "exclusiveMinimum": 0,
                "maximum": 5,
                "type": "number"
              }
            },
            "required": [
              "collector",
              "bounded",
              "integrity_observation_count",
              "timeout_seconds",
              "registry_byte_limit",
              "snapshot_byte_limit",
              "runtime_marker_byte_limit",
              "source_snapshot",
              "sources"
            ],
            "type": "object"
          },
          "outcome": {
            "enum": [
              "HEALTHY",
              "FAILED",
              "STALE",
              "EXPIRED",
              "MISSING",
              "TIMED_OUT",
              "FUTURE",
              "UNKNOWN"
            ]
          },
          "read_only": {
            "const": true
          },
          "registry": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "profile_reference": {
                "const": "validation-profile-registry:FULL@1.0"
              },
              "registry_id": {
                "const": "forge-installed-health"
              },
              "registry_version": {
                "const": "1.0"
              },
              "schema_version": {
                "const": "1.0"
              }
            },
            "required": [
              "registry_id",
              "registry_version",
              "schema_version",
              "profile_reference",
              "digest"
            ],
            "type": "object"
          },
          "runtime_id": {
            "minLength": 1,
            "type": "string"
          },
          "product": {
            "const": "forge"
          },
          "product_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "schema_revision": {
            "const": "1.0"
          },
          "state": {
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNAVAILABLE",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "api_version",
          "schema_revision",
          "product",
          "product_version",
          "runtime_id",
          "installation_id",
          "evaluated_at",
          "capability_scope",
          "state",
          "liveness",
          "capabilities",
          "checks",
          "outcome",
          "read_only",
          "registry",
          "observation_provenance"
        ],
        "type": "object"
      },
      "MissionResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1"
          },
          "availability": {
            "const": "AVAILABLE"
          },
          "freshness": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNKNOWN"
            ]
          },
          "mission": {
            "additionalProperties": true,
            "properties": {
              "action_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "actions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dependencies": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "expected_evidence": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "id": {
                      "type": "string"
                    },
                    "intent_id": {
                      "type": "string"
                    },
                    "intent_revision": {
                      "type": "string"
                    },
                    "objective": {
                      "type": "string"
                    },
                    "order": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "schema_version": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "order",
                    "id",
                    "intent_id",
                    "intent_revision",
                    "dependencies",
                    "status",
                    "objective",
                    "expected_evidence"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "criteria": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "evidence_lineage": {
                "additionalProperties": false,
                "properties": {
                  "criterion_assessment": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "criterion_assessment_history": {
                    "items": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "type": "array"
                  },
                  "execution_attempts": {
                    "items": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "type": "array"
                  },
                  "execution_evidence": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "repository_truth": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "execution_evidence",
                  "execution_attempts",
                  "repository_truth",
                  "criterion_assessment",
                  "criterion_assessment_history"
                ],
                "type": "object"
              },
              "mission_id": {
                "minLength": 1,
                "type": "string"
              },
              "revision": {
                "minimum": 1,
                "type": "integer"
              },
              "status": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "mission_id",
              "status",
              "revision",
              "action_ids",
              "criteria",
              "actions",
              "evidence_lineage"
            ],
            "type": "object"
          },
          "read_only": {
            "const": true
          },
          "source_observed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "api_version",
          "availability",
          "freshness",
          "source_observed_at",
          "read_only",
          "mission"
        ],
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1"
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ]
          },
          "freshness": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNKNOWN",
              "UNAVAILABLE"
            ]
          },
          "read_only": {
            "const": true
          },
          "runtime": {
            "additionalProperties": true,
            "required": [
              "product_version",
              "data_root",
              "initialized",
              "runtime_status",
              "execution_host_peer"
            ],
            "type": "object"
          },
          "source_observed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "api_version",
          "availability",
          "freshness",
          "source_observed_at",
          "read_only",
          "runtime"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Forge Operations Read API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Assess installed Forge health from the canonical component registry and bounded runtime observations.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The installed runtime is healthy"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bearer authentication is missing or invalid"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HealthResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            },
            "description": "The installed runtime is not healthy or cannot be assessed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/missions/{mission_id}": {
      "get": {
        "description": "Read one authoritative installed Mission projection without changing it.",
        "parameters": [
          {
            "in": "path",
            "name": "mission_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionResponse"
                }
              }
            },
            "description": "Mission projection is available"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Mission reference is invalid"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bearer authentication is missing or invalid"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Mission is missing"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Mission identity is ambiguous or inconsistent"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Mission projection is unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/status": {
      "get": {
        "description": "Read the authoritative installed Forge runtime status projection.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Status projection is available"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bearer authentication is missing or invalid"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Installed runtime projection is unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ]
}
