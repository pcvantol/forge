{
  "info": {
    "name": "Forge Server Runtime V1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8765"
    },
    {
      "key": "token",
      "value": "replace-with-private-server-token"
    },
    {
      "key": "missionId",
      "value": "MISSION-0001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Read installed runtime status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "status"
          ]
        }
      }
    },
    {
      "name": "Read aggregate health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Read Server/provider/peer/scheduler readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/readiness",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "readiness"
          ]
        }
      }
    },
    {
      "name": "Read instance identity and deployment bindings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/instance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "instance"
          ]
        }
      }
    },
    {
      "name": "Read product version and storage schema",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/version",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "version"
          ]
        }
      }
    },
    {
      "name": "Read secret-free instance provider context",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/provider-context",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "provider-context"
          ]
        }
      }
    },
    {
      "name": "Configure secret-free instance provider context",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/provider-context",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "provider-context"
          ]
        }
      }
    },
    {
      "name": "Perform authenticated EP compatibility preflight",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/execution-host/preflight",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "execution-host",
            "preflight"
          ]
        }
      }
    },
    {
      "name": "Configure the Forge-owned EP peer binding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/execution-host/configure",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "execution-host",
            "configure"
          ]
        }
      }
    },
    {
      "name": "Inspect a Mission document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/missions/inspect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "missions",
            "inspect"
          ]
        }
