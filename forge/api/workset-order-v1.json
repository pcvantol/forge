  "$defs": {
    "legacy_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "committed_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "mission_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mission_state_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "approved": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "eligibility": {
          "enum": [
            "ELIGIBLE",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "execution_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "engineering_result": {
          "enum": [
            "PROVEN",
            "UNPROVEN",
            "UNKNOWN"
          ]
        },
        "review_state": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NONE",
            "UNKNOWN"
          ]
        },
        "final_acceptance": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "effect_mode": {
          "enum": [
            "READ_ONLY_ASSESSMENT",
            "DOCUMENTATION_ONLY",
            "ARCHITECTURE_DESIGN_ONLY",
            "BOUNDED_REPOSITORY_CHANGE",
            "UNKNOWN"
          ]
        },
        "dependencies": {
          "type": "array",
