            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "detail_reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "mission_id"
              ],
              "properties": {
                "kind": {
                  "const": "MISSION_REVIEW"
                },
                "mission_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              }
            }
          ]
        },
        "allocation_binding": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "candidate_id",
                "subject_revision",
                "mission_id",
                "installation_id",
                "envelope_digest"
              ],
              "properties": {
                "kind": {
                  "const": "CANONICAL_CANDIDATE_INTAKE"
                },
                "candidate_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "subject_revision": {
