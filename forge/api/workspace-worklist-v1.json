{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-workspace-worklist/v1",
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "committed_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "mission_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mission_state_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "approved": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "eligibility": {
          "enum": [
            "ELIGIBLE",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        },
        "active": {
          "type": "boolean"
        },
        "execution_state": {
          "type": "string"
        },
        "engineering_result": {
          "enum": [
            "PROVEN",
            "UNPROVEN",
            "UNKNOWN"
          ]
        },
        "review_state": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NONE",
            "UNKNOWN"
          ]
        },
        "final_acceptance": {
          "enum": [
            "WAITING",
            "ACCEPTED",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "effect_mode": {
          "enum": [
            "READ_ONLY_ASSESSMENT",
            "DOCUMENTATION_ONLY",
            "ARCHITECTURE_DESIGN_ONLY",
            "BOUNDED_REPOSITORY_CHANGE",
            "UNKNOWN"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "detail_reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "mission_id"
              ],
              "properties": {
                "kind": {
                  "const": "MISSION_REVIEW"
                },
                "mission_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              }
            }
          ]
        }
      },
      "required": [
        "candidate_id",
        "subject_revision",
        "committed_order",
        "title",
        "mission_id",
        "mission_state_revision",
        "approved",
        "released",
        "eligibility",
        "blocking_reasons",
        "active",
        "execution_state",
        "engineering_result",
        "review_state",
        "final_acceptance",
        "completed",
        "effect_mode",
        "dependencies",
        "detail_reference"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "forge-workspace-worklist/v1"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "principal_id",
            "workset_id",
            "project_id"
          ],
          "properties": {
            "kind": {
              "const": "EXPLICIT_WORKSET"
            },
            "principal_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "workset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "project_id": {
              "type": "null"
            }
          }
        },
        "membership_revision": {
          "type": "string"
        },
        "selector_revision": {
          "type": "string"
        },
        "workset_revision": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "freshness": {
          "const": "CURRENT_READBACK"
        },
        "completeness": {
          "const": "COMPLETE_WITHIN_SCOPE"
        },
        "activation_support": {
          "enum": [
            "NOT_YET_QUALIFIED",
            "QUALIFIED_SERIAL_APPROVED_WORKLIST"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "read_only": {
          "const": true
        }
      },
      "required": [
        "contract_version",
        "instance_id",
        "scope",
        "membership_revision",
        "selector_revision",
        "workset_revision",
        "snapshot_revision",
        "observed_at",
        "freshness",
        "completeness",
        "activation_support",
        "items",
        "read_only"
      ]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "instance_id",
        "principal_id",
        "workset_ids",
        "read_only"
      ],
      "properties": {
        "contract_version": {
          "const": "forge-workspace-worklist-scopes/v1"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "read_only": {
          "const": true
        }
      }
    }
  },
  "$ref": "#/$defs/projection"
}
