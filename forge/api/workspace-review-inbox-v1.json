{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcvantol/forge/blob/main/forge/api/workspace-review-inbox-v1.json",
  "title": "Forge Workspace scoped Mission review V1",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_id", "role", "role_actor", "capability", "expires_at"],
      "properties": {
        "principal_id": {"$ref": "#/$defs/id"},
        "role": {"const": "platform_architect"},
        "role_actor": {"const": "primary_operator"},
        "capability": {"const": "ARCHITECTURE_APPROVAL"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "subject_digest", "subject_revision", "mission_state_revision", "completed_action_id", "evidence_digest", "policy_revision", "policy_digest", "required_role", "required_role_actor", "required_capability", "reason", "blocking_scope", "status"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "subject_revision": {"type": ["string", "null"]},
        "mission_state_revision": {"type": "integer", "minimum": 1},
        "completed_action_id": {"$ref": "#/$defs/nullable_id"},
        "evidence_digest": {"$ref": "#/$defs/nullable_digest"},
        "policy_revision": {"type": ["string", "null"]},
        "policy_digest": {"$ref": "#/$defs/nullable_digest"},
        "required_role": {"type": "string", "maxLength": 64},
        "required_role_actor": {"type": ["string", "null"], "maxLength": 128},
        "required_capability": {"type": "string", "maxLength": 64},
        "reason": {"type": ["string", "null"], "maxLength": 512},
        "blocking_scope": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
        "status": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "outcome", "decision_digest"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["approve", "reject", "amend", "defer"]},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "digest", "receipt_id"],
      "properties": {
        "kind": {"const": "FORGE_EXECUTION_EVIDENCE"},
        "digest": {"$ref": "#/$defs/digest"},
        "receipt_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "action_result": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "status", "outcome", "evidence_reference"],
      "properties": {
        "action_id": {"$ref": "#/$defs/id"},
        "status": {"type": ["string", "null"], "maxLength": 32},
        "outcome": {"type": ["string", "null"], "maxLength": 32},
        "evidence_reference": {"oneOf": [{"$ref": "#/$defs/evidence_reference"}, {"type": "null"}]}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "instance_id", "mission_id", "authority", "title", "lifecycle_state", "mission_state_revision", "review_kind", "decision", "requirement", "action_result", "allowed_outcomes", "observed_at", "freshness"],
      "properties": {
        "contract_version": {"const": "forge-workspace-review-inbox/v1"},
        "instance_id": {"$ref": "#/$defs/id"},
        "mission_id": {"$ref": "#/$defs/id"},
        "authority": {"$ref": "#/$defs/authority"},
        "title": {"type": ["string", "null"], "maxLength": 160},
        "lifecycle_state": {"type": "string", "minLength": 1, "maxLength": 64},
        "mission_state_revision": {"type": "integer", "minimum": 1},
        "review_kind": {"enum": ["PROGRESSION", "FINAL_ACCEPTANCE", "EXTERNAL_GATE", "NONE"]},
        "decision": {"oneOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
        "requirement": {"oneOf": [{"$ref": "#/$defs/requirement"}, {"type": "null"}]},
        "action_result": {"oneOf": [{"$ref": "#/$defs/action_result"}, {"type": "null"}]},
        "allowed_outcomes": {"type": "array", "uniqueItems": true, "maxItems": 4, "items": {"enum": ["approve", "reject", "amend", "defer"]}},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness": {"const": "CURRENT_FORGE_RUNTIME_READBACK"}
      }
    },
    "inbox": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "instance_id", "scope", "items", "read_only"],
      "properties": {
        "contract_version": {"const": "forge-workspace-review-inbox/v1"},
        "instance_id": {"$ref": "#/$defs/id"},
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "principal_id", "mission_ids", "complete_within_scope"],
          "properties": {
            "kind": {"const": "EXPLICIT_MISSION_SET"},
            "principal_id": {"$ref": "#/$defs/id"},
            "mission_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "complete_within_scope": {"const": true}
          }
        },
        "items": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/item"}},
        "read_only": {"const": true}
      }
    },
    "decision_request": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "operation_id", "requirement_id", "subject_digest", "mission_state_revision", "evidence_digest", "policy_revision", "decision", "reason"],
      "properties": {
        "contract_version": {"const": "forge-workspace-review-decision/v1"},
        "operation_id": {"$ref": "#/$defs/id"},
        "requirement_id": {"$ref": "#/$defs/id"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "mission_state_revision": {"type": "integer", "minimum": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "decision": {"enum": ["approve", "reject", "amend", "defer"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "mission_id", "requirement_id", "subject_digest", "decision", "decision_digest", "recorded_at"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "mission_id": {"$ref": "#/$defs/id"},
        "requirement_id": {"$ref": "#/$defs/id"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "decision": {"enum": ["approve", "reject", "amend", "defer"]},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "operation_response": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "operation", "current", "read_only"],
      "properties": {
        "contract_version": {"const": "forge-workspace-review-operation/v1"},
        "operation": {"$ref": "#/$defs/operation"},
        "current": {"$ref": "#/$defs/item"},
        "read_only": {"const": true}
      }
    },
    "decision_response": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "operation", "current", "runtime_status", "recorded"],
      "properties": {
        "contract_version": {"const": "forge-workspace-review-operation/v1"},
        "operation": {"$ref": "#/$defs/operation"},
        "current": {"$ref": "#/$defs/item"},
        "runtime_status": {"type": ["string", "null"], "maxLength": 64},
        "recorded": {"type": "boolean"}
      }
    }
  }
}
