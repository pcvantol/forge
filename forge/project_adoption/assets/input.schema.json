{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "pb-adoption-preview/1.0"
    },
    "bootstrap_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "baseline",
        "mode",
        "role",
        "document_language",
        "identity",
        "product",
        "source_references",
        "authority_contract_reference",
        "license_profile",
        "security_profile",
        "stack_profile",
        "host_profile"
      ],
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "pb-render/1.0"
        },
        "baseline": {
          "type": "string",
          "const": "portable-docs/1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "GENESIS",
            "MANAGED"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "authority",
            "child"
          ]
        },
        "document_language": {
          "type": "string",
          "enum": [
            "en"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "project_id",
            "repository_id",
            "authority_repository_id",
            "owner_reference"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PROVISIONAL_REFERENCE",
                "OWNER_REGISTERED_REFERENCE"
              ]
            },
            "project_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "[a-z0-9][a-z0-9._-]*"
            },
            "repository_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "[a-z0-9][a-z0-9._-]*"
            },
            "authority_repository_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "[a-z0-9][a-z0-9._-]*"
            },
            "owner_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            }
          }
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "purpose",
            "users",
            "non_goals",
            "constraints",
            "open_questions"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            },
            "users": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            },
            "non_goals": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            },
            "constraints": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
            },
            "open_questions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
              }
            }
          }
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "reference",
              "digest"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "enum": [
                  "USER_DECLARED",
                  "BUSINESS",
                  "ARCHITECTURE",
                  "SOURCE_DOCUMENT"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
              },
              "digest": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              }
            }
          }
        },
        "authority_contract_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "license_profile": {
          "type": "string",
          "enum": [
            "UNDECIDED"
          ]
        },
        "security_profile": {
          "type": "string",
          "enum": [
            "DOCUMENT_ONLY"
          ]
        },
        "stack_profile": {
          "type": "string",
          "enum": [
            "NO_PRODUCT_CODE"
          ]
        },
        "host_profile": {
          "type": "string",
          "enum": [
            "LOCAL_POSIX",
            "GITHUB_DOCUMENTS"
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "supplied-document-inventory/1.0"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "SUPPLIED_OBSERVATION"
            },
            "qualification": {
              "type": "string",
              "const": "SUPPLIED_UNVERIFIED"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"
            },
            "declared_current_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,255}"
            }
          },
          "required": [
            "kind",
            "qualification",
            "repository_id",
            "revision",
            "declared_current_revision",
            "reference"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "COMPLETE_SUPPLIED",
                "PARTIAL_SUPPLIED"
              ]
            },
            "covered_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 64
            },
            "excluded_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 64
            }
          },
          "required": [
            "scope",
            "covered_paths",
            "excluded_paths"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "worktree_state": {
              "type": "string",
              "enum": [
                "CLEAN_SUPPLIED",
                "DIRTY_SUPPLIED",
                "UNKNOWN"
              ]
            },
            "staged_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 32
            },
            "dirty_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 32
            },
            "untracked_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 32
            },
            "ignored_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 32
            },
            "product_code": {
              "type": "string",
              "enum": [
                "PRESENT_SUPPLIED",
                "ABSENT_SUPPLIED",
                "UNKNOWN"
              ]
            }
          },
          "required": [
            "worktree_state",
            "staged_paths",
            "dirty_paths",
            "untracked_paths",
            "ignored_paths",
            "product_code"
          ]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "type": "string",
                "enum": [
                  "PRESENT",
                  "ABSENT",
                  "UNKNOWN",
                  "REFUSED",
                  "NOT_EXAMINED"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "mode": {
                "type": "integer",
                "enum": [
                  384,
                  420,
                  493
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 8192
              },
              "artifact_hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "semantic_owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "update_class": {
                "type": "string",
                "enum": [
                  "PROJECT_OWNED",
                  "PINNED_BASELINE",
                  "DERIVED_PROJECTION",
                  "APPEND_ONLY_EVIDENCE_REFERENCE",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "path",
              "status"
            ]
          },
          "maxItems": 32
        }
      },
      "required": [
        "contract_version",
        "origin",
        "coverage",
        "context",
        "documents"
      ]
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "requested_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 20,
      "minItems": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "choice": {
            "type": "string",
            "enum": [
              "LINK_EXISTING",
              "PROPOSE_REPLACEMENT"
            ]
          }
        },
        "required": [
          "artifact_path",
          "source_path",
          "choice"
        ]
      },
      "maxItems": 20
    }
  },
  "required": [
    "contract_version",
    "bootstrap_input",
    "inventory",
    "inventory_digest",
    "requested_artifacts",
    "mappings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:pb-adoption-preview:input:1.0"
}
