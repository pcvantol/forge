{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/engineering-proposal-0.6.schema.json",
  "title": "Forge Engineering Proposal 0.6",
  "description": "A generated governed intention. It does not approve, execute, or modify engineering work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "objective", "expected_outcome", "creation_metadata", "scope", "rationale", "dependencies", "risk", "evidence_references", "status"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": "string", "minLength": 1},
    "creation_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "generator_version", "workspace_id", "source_plan_id", "source_increment_id"],
      "properties": {
        "generator": {"type": "string", "minLength": 1},
        "generator_version": {"const": "0.6"},
        "workspace_id": {"$ref": "common.schema.json#/$defs/id"},
        "source_plan_id": {"$ref": "common.schema.json#/$defs/id"},
        "source_increment_id": {"$ref": "common.schema.json#/$defs/id"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included_work", "excluded_work", "affected_capabilities"],
      "properties": {
        "included_work": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded_work": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "affected_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rationale": {
      "type": "object", "additionalProperties": false,
      "required": ["why_this_increment_exists", "roadmap_relationship", "evidence_relationship"],
      "properties": {
        "why_this_increment_exists": {"type": "string", "minLength": 1},
        "roadmap_relationship": {"type": "string", "minLength": 1},
        "evidence_relationship": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["required_capabilities", "required_previous_increments", "assumptions"],
      "properties": {
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
        "required_previous_increments": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["technical_risk", "governance_risk", "scope_risk"],
      "properties": {
        "technical_risk": {"$ref": "#/$defs/risk_assessment"},
        "governance_risk": {"$ref": "#/$defs/risk_assessment"},
        "scope_risk": {"$ref": "#/$defs/risk_assessment"}
      }
    },
    "evidence_references": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-reference-0.5.schema.json"}},
    "status": {"type": "string", "enum": ["DRAFT", "PROPOSED", "APPROVED", "EXECUTED"]}
  },
  "$defs": {
    "risk_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"type": "string", "enum": ["low", "medium", "high"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
