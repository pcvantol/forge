{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/decision-evidence-1.0.schema.json",
  "title": "Forge Decision Evidence 1.0",
  "type": "object",
  "required": ["schema_version", "id", "decision_type", "timestamp", "decision", "reasoning_summary", "confidence", "alternatives_considered", "chosen_alternative", "approval_state", "decision_outcome"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "decision_type": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "reasoning_summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "object"},
    "alternatives_considered": {"type": "array", "minItems": 1},
    "chosen_alternative": {"type": "string", "minLength": 1},
    "approval_state": {"type": "string", "minLength": 1},
    "decision_outcome": {"type": "string", "minLength": 1}
  }
}
