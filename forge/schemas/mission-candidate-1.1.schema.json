{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/mission-candidate-1.1.schema.json",
  "title": "Forge Mission Candidate",
  "description": "A business-governed Portfolio opportunity; never an executable Mission.",
  "type": "object",
  "required": ["schema_version", "id", "title", "summary", "business_objective", "business_value", "estimated_engineering_effort", "confidence", "required_disciplines", "dependencies", "architecture_review_reference", "mission_recommendation_reference", "priority", "business_rationale", "maturity", "status", "solution_template_reference"],
  "properties": {
    "schema_version": {"const": "1.1"}, "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "business_objective": {"type": "string", "minLength": 1}, "business_value": {"type": "string", "minLength": 1},
    "estimated_engineering_effort": {"enum": ["small", "medium", "large"]}, "confidence": {"enum": ["low", "medium", "high"]}, "required_disciplines": {"type": "array", "uniqueItems": true}, "dependencies": {"type": "array", "uniqueItems": true},
    "architecture_review_reference": {"type": ["string", "null"], "minLength": 1}, "mission_recommendation_reference": {"type": ["string", "null"], "minLength": 1}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}, "business_rationale": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["idea", "research", "feasibility", "proposal", "ready_for_architecture"]}, "status": {"enum": ["business_review", "approved_for_architecture", "rejected", "archived"]}, "solution_template_reference": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false
}
