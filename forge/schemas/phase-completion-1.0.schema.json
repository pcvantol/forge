{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/phase-completion-1.0.schema.json",
  "title": "Forge Phase Completion 1.0",
  "description": "A local, evidence-only phase completion document. It never fetches evidence or executes work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "schema_version", "phase", "evidence"],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "source_version", "locator", "content_digest"],
      "properties": {
        "kind": {"enum": ["documentation", "validation", "test", "engineering_artifact", "repair_report"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "outcome", "reference"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["PASS", "FAIL"]},
        "reference": {"$ref": "#/$defs/reference"}
      }
    }
  },
  "properties": {
    "document_type": {"const": "forge.phase_completion"},
    "schema_version": {"const": "1.0"},
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "objective", "criteria"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
        "completion_declaration": {"type": "object", "additionalProperties": false, "required": ["reference"], "properties": {"reference": {"$ref": "#/$defs/reference"}}}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  }
}
