{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/solution-template-1.0.schema.json",
  "title": "Forge Solution Template",
  "description": "A reusable advisory software-solution archetype; never a Mission approval or execution request.",
  "type": "object",
  "required": ["schema_version", "identifier", "version", "name", "purpose", "typical_users", "typical_stakeholders", "business_objectives", "typical_capabilities", "recommended_mission_candidates", "architecture_patterns", "engineering_disciplines", "risks", "compliance_considerations", "implementation_phases"],
  "properties": {
    "schema_version": {"const": "1.0"}, "identifier": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
    "typical_users": {"type": "array", "minItems": 1, "uniqueItems": true}, "typical_stakeholders": {"type": "array", "minItems": 1, "uniqueItems": true}, "business_objectives": {"type": "array", "minItems": 1, "uniqueItems": true}, "typical_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true},
    "recommended_mission_candidates": {"type": "array", "minItems": 1, "uniqueItems": true}, "architecture_patterns": {"type": "array", "minItems": 1, "uniqueItems": true}, "engineering_disciplines": {"type": "array", "minItems": 1, "uniqueItems": true}, "risks": {"type": "array", "minItems": 1, "uniqueItems": true}, "compliance_considerations": {"type": "array", "minItems": 1, "uniqueItems": true}, "implementation_phases": {"type": "array", "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
