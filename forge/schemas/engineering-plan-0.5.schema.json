{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/engineering-plan-0.5.schema.json",
  "title": "Forge Engineering Plan 0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "workspace_id", "ordered_increment_ids", "dependencies", "assumptions", "status", "evidence_references"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "workspace_id": {"$ref": "common.schema.json#/$defs/id"},
    "ordered_increment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["increment_id", "depends_on"],
        "properties": {
          "increment_id": {"$ref": "common.schema.json#/$defs/id"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"type": "string", "enum": ["draft", "proposed"]},
    "evidence_references": {"type": "array", "items": {"$ref": "evidence-reference-0.5.schema.json"}}
  }
}
