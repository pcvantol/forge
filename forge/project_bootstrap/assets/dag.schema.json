{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "input_digest",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "const": "DRAFT"
    },
    "input_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "nodes": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
