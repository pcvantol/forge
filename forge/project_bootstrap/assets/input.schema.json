{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "baseline",
    "mode",
    "role",
    "document_language",
    "identity",
    "product",
    "source_references",
    "authority_contract_reference",
    "license_profile",
    "security_profile",
    "stack_profile",
    "host_profile"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "pb-render/1.0"
    },
    "baseline": {
      "type": "string",
      "const": "portable-docs/1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "GENESIS",
        "MANAGED"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "authority",
        "child"
      ]
    },
    "document_language": {
      "type": "string",
      "enum": [
        "en"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "project_id",
        "repository_id",
        "authority_repository_id",
        "owner_reference"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PROVISIONAL_REFERENCE",
            "OWNER_REGISTERED_REFERENCE"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "repository_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "authority_repository_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "owner_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "users",
        "non_goals",
        "constraints",
        "open_questions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "users": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "non_goals": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "constraints": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        },
        "open_questions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "reference",
          "digest"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "enum": [
              "USER_DECLARED",
              "BUSINESS",
              "ARCHITECTURE",
              "SOURCE_DOCUMENT"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
          },
          "digest": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        }
      }
    },
    "authority_contract_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
    },
    "license_profile": {
      "type": "string",
      "enum": [
        "UNDECIDED"
      ]
    },
    "security_profile": {
      "type": "string",
      "enum": [
        "DOCUMENT_ONLY"
      ]
    },
    "stack_profile": {
      "type": "string",
      "enum": [
        "NO_PRODUCT_CODE"
      ]
    },
    "host_profile": {
      "type": "string",
      "enum": [
        "LOCAL_POSIX",
        "GITHUB_DOCUMENTS"
      ]
    }
  }
}
