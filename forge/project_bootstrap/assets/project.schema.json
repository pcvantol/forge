{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "identity_reference",
    "document_language",
    "input_digest",
    "state"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "pb-render/1.0"
    },
    "identity_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "project_id",
        "repository_id",
        "authority_repository_id",
        "owner_reference"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PROVISIONAL_REFERENCE",
            "OWNER_REGISTERED_REFERENCE"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "repository_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "authority_repository_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "[a-z0-9][a-z0-9._-]*"
        },
        "owner_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+"
        }
      }
    },
    "document_language": {
      "type": "string",
      "const": "en"
    },
    "input_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "state": {
      "type": "string",
      "const": "PROPOSAL"
    }
  }
}
