{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "renderer_version",
    "baseline",
    "input_digest",
    "state",
    "artifacts",
    "self_reference",
    "manifest_digest",
    "renderer_source_digest"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "pb-render/1.0"
    },
    "renderer_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "baseline": {
      "type": "string",
      "const": "portable-docs/1.0.0"
    },
    "input_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "state": {
      "type": "string",
      "const": "RENDERED_PROPOSAL"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "expected_before",
          "expected_after_digest",
          "bytes",
          "file_mode",
          "encoding",
          "update_class",
          "artifact_id",
          "condition",
          "semantic_owner",
          "physical_writer",
          "schema_or_template_version",
          "source_digest",
          "input_digest",
          "maximum_bytes",
          "validation_requirements"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expected_before": {
            "type": "string",
            "const": "ABSENT"
          },
          "expected_after_digest": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 131072
          },
          "file_mode": {
            "type": "string",
            "const": "0644"
          },
          "encoding": {
            "type": "string",
            "const": "UTF-8"
          },
          "update_class": {
            "type": "string",
            "enum": [
              "PROJECT_OWNED",
              "PINNED_BASELINE",
              "DERIVED_PROJECTION",
              "APPEND_ONLY_EVIDENCE_REFERENCE"
            ]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "semantic_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "physical_writer": {
            "type": "string",
            "const": "engineering-platform"
          },
          "schema_or_template_version": {
            "type": "string",
            "const": "pb-render/1.0"
          },
          "source_digest": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "input_digest": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "maximum_bytes": {
            "type": "integer",
            "const": 131072
          },
          "validation_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "const": "PORTABLE_HASH_SCHEMA_PROFILE"
            }
          }
        }
      }
    },
    "self_reference": {
      "type": "string",
      "const": "manifest excluded from artifact hashes; digest excludes manifest_digest"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "renderer_source_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  }
}
